{
  "rewrites": [
    {
      "source": "/naghma-quran.apk",
      "destination": "/mihrab-noor.apk"
    },
    {
      "source": "/najm-quran.apk",
      "destination": "/mihrab-noor.apk"
    },
    {
      "source": "/((?!assets/|data/|ads\\.txt$|robots\\.txt$|sitemap\\.xml$|google.*\\.html$|version\\.json$|.*\\.apk$|.*\\.png$|.*\\.svg$|.*\\.webmanifest$|sw\\.js$|workbox-.*\\.js$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"mihrab-noor.apk\"" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
