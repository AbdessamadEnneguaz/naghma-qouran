{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "android:sync": "node -e \"const fs=require('fs');const url=process.env.CAPACITOR_SERVER_URL;if(url){const c=JSON.parse(fs.readFileSync('capacitor.config.json','utf8'));c.server={...c.server,url,cleartext:url.startsWith('http://')};fs.writeFileSync('capacitor.config.json',JSON.stringify(c,null,2)+'\\n');}\" && npm run build && npx @capacitor/assets generate --android && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.4",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^6.2.4",
    "@capacitor/core": "^6.2.4",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@capawesome-team/capacitor-android-foreground-service": "^6.2.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
